# Copy to .env:  cp .env.example .env
# The two secrets below are DEV-ONLY placeholders so `docker compose up` works out
# of the box. The API refuses to start with them when ENVIRONMENT=production.
# Generate real ones:  python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#                      python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# Backend
ENVIRONMENT=development
MASTER_ENCRYPTION_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1jaGFuZ2UtbWUhISE=
JWT_SECRET=dev-only-jwt-secret-change-me-before-deploying
ALLOWED_ORIGINS=http://localhost:3000
REGISTRATION_OPEN=true
COOKIE_SECURE=false
# Demo provider that answers without any API key (for trying the app / E2E tests).
ENABLE_MOCK_PROVIDER=true
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Database (used by the db container and the backend connection string)
POSTGRES_USER=offall
POSTGRES_PASSWORD=offall
POSTGRES_DB=aigateway
# DATABASE_URL / REDIS_URL are set by docker-compose.yml; set them only outside compose:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/aigateway
# REDIS_URL=redis://redis:6379/0

# Frontend
WEB_PORT=3000
# The browser always calls the same origin (/api is proxied by Next.js), so no
# NEXT_PUBLIC_API_URL is needed. API_INTERNAL_URL is baked in at build time.
